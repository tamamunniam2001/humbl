generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  password       String
  role           Role         @default(CASHIER)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  customRoleId   String?
  customRole     CustomRole?  @relation(fields: [customRoleId], references: [id])
  transactions   Transaction[]
  dailyReports   DailyReport[]
  expenses       Expense[]
  stockOpnames   StockOpname[]
  wasteNotes     WasteNote[]  @relation("WasteNoteCreator")
  // OperationalBelanja relations (added to satisfy Prisma validation)
  operationalBelanjaAsRequester OperationalBelanja[] @relation("OperationalBelanjaRequester")
  operationalBelanjaAsApprovedBy OperationalBelanja[] @relation("ApprovedOperationalBelanja")
}

model CustomRole {
  id           String   @id @default(cuid())
  name         String   @unique
  allowedPaths Json     @default("[]")
  createdAt    DateTime @default(now())
  users        User[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id               String              @id @default(cuid())
  code             String?             @unique
  name             String
  price            Int
  stock            Int                 @default(0)
  imageUrl         String?
  isActive         Boolean             @default(true)
  categoryId       String?
  category         Category?           @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  ingredients      ProductIngredient[]
  createdAt        DateTime            @default(now())
  description      String?             @default("")

  @@index([isActive])
  @@index([categoryId])
}

model Ingredient {
  id           String               @id @default(cuid())
  code         String?              @unique
  name         String               @unique
  unit         String
  price        Float?               // harga beli per pack/kemasan (auto-calc jika isComposite)
  packSize     Float?               // isi per pack (dalam satuan unit)
  isComposite  Boolean              @default(false) // bahan baku jadi
  products     ProductIngredient[]
  components   IngredientComponent[] @relation("CompositeIngredient")
  usedIn       IngredientComponent[] @relation("ComponentIngredient")
  wasteItems   WasteNoteItem[]
}

model IngredientComponent {
  id             String     @id @default(cuid())
  compositeId    String
  composite      Ingredient @relation("CompositeIngredient", fields: [compositeId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation("ComponentIngredient", fields: [ingredientId], references: [id])
  qty            Float

  @@unique([compositeId, ingredientId])
  @@index([compositeId])
}

model ProductIngredient {
  id           String     @id @default(cuid())
  qty          Float
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
}

model Member {
  id            String        @id @default(cuid())
  name          String
  phone         String        @unique
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]

  @@index([name])
}

model Transaction {
  id           String      @id @default(cuid())
  invoiceNo    String      @unique
  customerName String?     @default("")
  note         String?     @default("")
  total        Int
  payment      Int
  change       Int
  payMethod    PayMethod   @default(CASH)
  status       TxStatus    @default(COMPLETED)
  servedAt     DateTime?
  // Diskon dan pajak — disimpan agar bisa ditampilkan kembali di history dan laporan
  discount     Int         @default(0)  // persen, misal 10 = 10%
  discountAmount Int       @default(0)  // nominal rupiah
  tax          Int         @default(0)  // persen
  taxAmount    Int         @default(0)  // nominal rupiah
  // Waktu asli sebelum open bill dipindahkan ke shift berikutnya (null = belum pernah dipindahkan)
  originalCreatedAt DateTime?
  cashierId    String
  cashier      User        @relation(fields: [cashierId], references: [id])
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?
  // Transaksi yang diinput manual oleh ADMIN (mis. rekonstruksi data)
  isManual     Boolean     @default(false)
  // Voucher yang dipakai (snapshot agar nilai historis tetap walau voucher diubah/dihapus)
  voucherId    String?
  voucher      Voucher?    @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherCode  String?     @default("")
  voucherDiscount Int      @default(0)  // nominal potongan dari voucher (rupiah)
  // Diskon member (snapshot dari PromoSettings saat transaksi dibuat/dibayar).
  // Tetap tersimpan walau pengaturan diubah kemudian — dipakai struk/history.
  memberDiscountType  VoucherType? @default(PERCENT)
  memberDiscountValue Int          @default(0)
  memberDiscountMax   Int          @default(0)
  memberDiscount      Int          @default(0) // nominal rupiah yang benar-benar dipotong
  // Member (opsional) — pembelian yang tercatat atas nama member.
  // onDelete: SetNull agar riwayat transaksi tetap aman bila member dihapus.
  memberId    String?
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([cashierId])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@index([voucherId])
  @@index([memberId])
}

model OrderItem {
  id            String      @id @default(cuid())
  qty           Int
  price         Int
  subtotal      Int
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  name          String?     @default("")
  code          String?     @default("")
  category      String?     @default("")
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([productId])
}

enum Role {
  ADMIN
  CASHIER
}

enum PayMethod {
  CASH
  QRIS
  TRANSFER
  NONTUNAI
}

enum TxStatus {
  COMPLETED
  CANCELLED
  PENDING
}

model DailyReport {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  shift            String?  @default("SHIFT_1")
  kasAwal          Int      @default(0)
  penjualan        Int      @default(0)
  uangDisetor      Int      @default(0)
  qris             Int      @default(0)
  transfer         Int      @default(0)
  pengeluaran      Json     @default("[]")
  piutang          Json     @default("[]")
  catatan          String?  @default("")
  closerName       String?  @default("")
  kasAkhirDisetor  Int      @default(0)
  cashierId        String
  cashier          User     @relation(fields: [cashierId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([cashierId])
  @@index([date])
}

model Employee {
  id            String       @id @default(cuid())
  name          String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  absences      Attendance[]
  helperOf      Attendance[] @relation("AttendanceHelper")
}

model SopItem {
  id        String   @id @default(cuid())
  text      String
  type      SopType
  order     Int      @default(0)
  isActive  Boolean  @default(true)
}

model ExpenseItem {
  id           String          @id @default(cuid())
  code         String?         @unique
  name         String
  category     String?         @default("")
  satuan       String?         @default("")
  satuanOpname String?         @default("")
  konversi     Float?          // 1 satuanOpname = konversi satuan
  minimalStok  Float?          // batas minimal dalam satuan opname; stok ≤ ini otomatis muncul di Pantau Bahan Baku
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  details      ExpenseDetail[]
  opnameItems  StockOpnameItem[]
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Expense {
  id        String        @id @default(cuid())
  date      DateTime      @default(now())
  total     Float
  catatan   String?       @default("")
  cashierId String
  cashier   User          @relation(fields: [cashierId], references: [id])
  items     ExpenseDetail[]
  createdAt DateTime      @default(now())

  @@index([cashierId])
  @@index([date])
}

model ExpenseDetail {
  id           String      @id @default(cuid())
  expenseId    String
  expense      Expense     @relation(fields: [expenseId], references: [id])
  expenseItemId String?
  expenseItem  ExpenseItem? @relation(fields: [expenseItemId], references: [id])
  name         String
  category     String?     @default("")
  keterangan   String?     @default("")
  satuan       String?     @default("")
  harga        Float
  isi          Float?
  qty          Float       @default(1)
  subtotal     Float

  @@index([expenseId])
}

model Attendance {
  id           String    @id @default(cuid())
  date         DateTime  @default(now())
  type         SopType
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  helperId     String?
  helper       Employee? @relation("AttendanceHelper", fields: [helperId], references: [id])
  kasAwal      Int       @default(0)
  checklist    Json      @default("[]")
  selfieUrl    String?   @default("")
  clockOut     DateTime?
  isActive     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([employeeId])
  @@index([date])
  @@index([type])
}

enum SopType {
  OPENING
  CLOSING_1
  CLOSING_2
  CLOSING_3
}

model MonthlyKas {
  id        String   @id @default(cuid())
  year      Int
  month     Int      // 0-11
  kasAwal   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model InventoryItem {
  id        String             @id @default(cuid())
  name      String
  qty       Float              @default(0)
  satuan    String?            @default("")
  category  String?            @default("")
  imageUrl  String?            @db.Text
  note      String?            @default("")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  opnameItems StockOpnameItem[]

  @@index([category])
}

model StockOpname {
  id         String            @id @default(cuid())
  date       DateTime          @default(now())
  note       String?           @default("")
  categories String?           @default("")
  status     OpnameStatus      @default(DRAFT)
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  items      StockOpnameItem[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([date])
  @@index([userId])
}

model StockOpnameItem {
  id              String        @id @default(cuid())
  opnameId        String
  opname          StockOpname   @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  expenseItemId   String?
  expenseItem     ExpenseItem?  @relation(fields: [expenseItemId], references: [id])
  itemName        String        @default("")
  satuan          String?       @default("")
  isManual        Boolean       @default(false)
  qtySystem       Float         @default(0)
  qtyActual       Float         @default(0)
  selisih         Float         @default(0)
  hargaManual     Float?        // harga satuan untuk item manual
  isRequested     Boolean       @default(false)
  requestStatus   RequestStatus @default(BELUM_DIBELI) // status pemantauan permintaan (Pantau Bahan Baku)
  requestQty      Float?        // qty yang direquest untuk restock
  note            String?       @default("")

  @@index([opnameId])
  @@index([inventoryItemId])
  @@index([expenseItemId])
}

model ReceiptSettings {
  id                String   @id @default("singleton")
  storeName         String   @default("HUMBL")
  tagline           String   @default("Struk Pembayaran")
  footer            String   @default("Terima kasih sudah berkunjung!\nHumbl") @db.Text
  printWidth        Int      @default(32)
  lineSpacing       Int      @default(1)
  footerLineSpacing Int      @default(1)
  barCategories     Json     @default("[]")
  kitchenCategories Json     @default("[]")
  updatedAt         DateTime @updatedAt
}

model Resi {
  id        String   @id @default(cuid())
  nama      String   @default("")
  imageUrl  String   @db.Text
  printed   Boolean  @default(false)
  printedAt DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Customer {
  id          String      @id @default(cuid())
  phone       String      @unique
  name        String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([phone])
}

enum OpnameStatus {
  DRAFT
  SELESAI
}

// Status pemantauan permintaan bahan baku (halaman Pantau Bahan Baku)
enum RequestStatus {
  BELUM_DIBELI
  DIPESAN
  SELESAI
}

// --- Operational Modules ---
enum BelanjaStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum SaldoReason {
  RESTOCK
  EXPENSE
  ADJUST
}

model OperationalBelanja {
  id          String         @id @default(cuid())
  roleKey     String         // identitas role / unit operasional (mis. "operasional")
  requesterId String?
  requester   User?          @relation("OperationalBelanjaRequester", fields: [requesterId], references: [id])
  requesterName String
  tanggal     DateTime
  keterangan  String?
  total       Float
  status      BelanjaStatus  @default(DRAFT)
  approvedById String?
  approvedByType String?
  approvedBy   User?          @relation("ApprovedOperationalBelanja", fields: [approvedById], references: [id])
  approvedAt  DateTime?
  adminNote   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       OperationalBelanjaItem[]
}

model OperationalBelanjaItem {
  id          String             @id @default(cuid())
  belanjaId   String
  belanja     OperationalBelanja @relation(fields: [belanjaId], references: [id])
  itemId      String?
  itemName    String
  harga       Float
  isi         Float?
  qty         Float
  satuan      String
  keterangan  String?
  subtotal    Float
  isManual    Boolean            @default(false)
  // Kategori yang dipilih saat input (khusus item manual / snapshot kategori item master)
  // agar saat pengajuan di-ACC, pengeluarannya masuk kategori yang benar — bukan 'Operasional'.
  category    String?            @default("")
}

model OperationalSaldoLedger {
  id           String      @id @default(cuid())
  roleKey      String
  type         SaldoReason
  amount       Float
  balanceAfter Float
  note         String?
  createdAt    DateTime    @default(now())
  createdBy    String?

  @@index([roleKey])
  @@index([type])
}

// --- Pengaturan Promo Global (halaman Promo & Voucher) ---
// Diskon otomatis untuk semua member aktif. Dipakai kasir saat nama
// pelanggan terhubung ke member: tombol "Diskon Member" muncul dan bila
// dipasang, potongan dihitung dari subtotal setelah diskon manual.
model PromoSettings {
  id                   String      @id @default("singleton")
  memberDiscountActive Boolean     @default(false)
  memberDiscountType   VoucherType @default(PERCENT)
  memberDiscountValue  Int         @default(0)
  memberDiscountMax    Int         @default(0)
  memberDiscountMin    Int         @default(0)
  updatedAt            DateTime    @updatedAt
}

// --- Voucher / Kode Promo ---
// Jenis potongan voucher:
//  PERCENT = potongan persentase dari subtotal (value = persen, mis. 10 = 10%)
//  NOMINAL = potongan tunai langsung (value = rupiah, mis. 5000)
enum VoucherType {
  PERCENT
  NOMINAL
}

model Voucher {
  id          String       @id @default(cuid())
  code        String       @unique        // kode voucher (disimpan UPPERCASE)
  description String?      @default("")
  type        VoucherType  @default(PERCENT)
  value       Int          @default(0)     // persen (jika PERCENT) atau rupiah (jika NOMINAL)
  minSpend    Int          @default(0)     // minimal subtotal agar voucher bisa dipakai (rupiah)
  maxDiscount Int          @default(0)     // batas maksimal potongan untuk tipe PERCENT (0 = tanpa batas)
  quota       Int          @default(0)     // 0 = tanpa batas kuota
  usedCount   Int          @default(0)     // jumlah kali voucher sudah terpakai
  startDate   DateTime?                     // masa berlaku mulai (null = langsung aktif)
  endDate     DateTime?                     // masa berlaku sampai (null = tanpa batas waktu)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  transactions Transaction[]

  @@index([isActive])
  @@index([code])
}

// --- Template Pesan WhatsApp (Pengaturan > Pesan WhatsApp) ---
// Template pesan yang dipilih admin saat mengirim WA ke member dari halaman
// Daftar Member (kirim lewat Fonnte). inputType menentukan input tambahan di
// popup kirim:
//  NONE          = teks biasa tanpa input tambahan
//  VOUCHER_CODE  = admin memilih kode voucher; placeholder {kode_voucher} dan
//                  {detail_voucher} diisi otomatis dari voucher tersebut
// Placeholder yang didukung di body: {nama}, {kode_voucher}, {detail_voucher}
enum TemplateInput {
  NONE
  VOUCHER_CODE
}

model MessageTemplate {
  id        String        @id @default(cuid())
  name      String        @unique
  body      String        @db.Text
  inputType TemplateInput @default(NONE)
  isActive  Boolean       @default(true)
  isWelcome Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([isActive])
}

// --- Catatan Waste (halaman Waste) ---
// Kategori kejadian waste. Label yang tampil di UI:
// RND = RnD, BUSUK = Busuk, TIDAK_TERPAKAI = Tidak Terpakai,
// DIPAKAI_SENDIRI = Dipakai Sendiri, SALAH_BUAT = Salah Buat, LAINNYA = Lainnya
enum WasteCategory {
  RND
  BUSUK
  TIDAK_TERPAKAI
  DIPAKAI_SENDIRI
  SALAH_BUAT
  LAINNYA
}

model WasteNote {
  id            String        @id @default(cuid())
  tanggal       DateTime
  category      WasteCategory
  note          String?       @db.Text
  total         Float         @default(0)
  createdById   String?
  createdBy     User?         @relation("WasteNoteCreator", fields: [createdById], references: [id])
  createdByName String        @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         WasteNoteItem[]

  @@index([tanggal])
  @@index([category])
}

model WasteNoteItem {
  id             String     @id @default(cuid())
  wasteNoteId    String
  wasteNote      WasteNote  @relation(fields: [wasteNoteId], references: [id], onDelete: Cascade)
  ingredientId   String?
  ingredient     Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  ingredientName String
  code           String?
  unit           String     @default("")
  qty            Float
  // hargaSatuan = harga per satuan (dari Bahan Baku: price / packSize, bisa dioverride)
  hargaSatuan    Float      @default(0)
  // snapshot harga & isi per kemasan saat catatan dibuat (agar nilai historis tidak berubah)
  hargaPack      Float?
  packSize       Float?
  subtotal       Float      @default(0)
  note           String?

  @@index([wasteNoteId])
  @@index([ingredientId])
}
